<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}{{ site.name }} Studio{% endblock %}</title>
        <meta name="description" content="{% block description %}{{ site.name }}, studio de création : branding, stratégie digitale,
            sites marketing, SaaS et applications, e-commerce et sites
            d’expérience.{% endblock %}">
        <meta name="theme-color" content="#0b0b0b">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 fill=%22%230b0b0b%22/><text x=%2212%22 y=%22104%22 font-family=%22Arial%22 font-weight=%22900%22 font-size=%22104%22 fill=%22%23fff%22>S</text><rect x=%2290%22 y=%2216%22 width=%2222%22 height=%2222%22 fill=%22%23ff4f9a%22/></svg>">

        {# Typographies : Archivo (titres, texte), Geist Mono (étiquettes), Instrument Serif (italiques). #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Quadrillage en filets fins, fixe, en mode « différence » pour rester visible sur noir comme sur blanc. #}
        <div class="lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

        {{ include('partials/_nav.html.twig') }}
        {{ include('partials/_menu.html.twig') }}

        <main>
            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_footer.html.twig') }}
    </body>
</html>
