<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}{{ site.name }} Studio{% endblock %}</title>
        <meta name="google-site-verification" content="CrYocgOlfpq84iZ-E_RnL0irKsyth6CuULSXsnrWIOY" />
        <meta name="description" content="{% block description %}{{ site.name }}, Agence web :  stratégie digitale,
            SaaS et applications, sites marketing, branding,  e-commerce et sites d’expérience.{% endblock %}">
        <meta name="theme-color" content="#0b0b0b">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 fill=%22%230b0b0b%22/><text x=%2212%22 y=%22104%22 font-family=%22Arial%22 font-weight=%22900%22 font-size=%22104%22 fill=%22%23fff%22>S</text><rect x=%2290%22 y=%2216%22 width=%2222%22 height=%2222%22 fill=%22%23ff4f9a%22/></svg>">

        {# Typographies : Archivo (titres, texte), Geist Mono (étiquettes), Instrument Serif (italiques),
           hébergées sur le site (assets/fonts/, déclarées dans assets/styles/fonts.css). #}
        <link rel="preload" href="{{ asset('fonts/archivo-latin-wdth-normal.woff2') }}" as="font" type="font/woff2" crossorigin>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Quadrillage en filets fins, fixe, en mode « différence » pour rester visible sur noir comme sur blanc. #}
        <div class="lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

        {{ include('partials/_nav.html.twig') }}
        {{ include('partials/_menu.html.twig') }}

        <main>
            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_footer.html.twig') }}
    </body>
</html>
